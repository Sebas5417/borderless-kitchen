NEXT_PUBLIC_SITE_URL=https://borderlesskitchenseries.com

# Direct link to the Tokyo Meets Tuscany Amazon listing. Leave unset (or "#")
# to use the built-in ASIN fallback in lib/amazon.ts.
NEXT_PUBLIC_AMAZON_URL_TMT=#

# Your Amazon Associates tracking ID (e.g. "borderlesskitchen-20"). Once set,
# every Amazon link on the site — book CTAs and the /shop pantry links —
# automatically earns commission. Leave empty until approved.
NEXT_PUBLIC_AMAZON_ASSOCIATES_TAG=

# Declared but unused at v1. Will branch behavior post-launch.
NEWSLETTER_PROVIDER=none

# MailerLite — required for /mini-course, /30-day-challenge, and every
# newsletter form to actually capture subscribers in production. Without
# these, signups silently succeed in the UI but the email is dropped.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# Optional safety net: a webhook (Zapier / Make / Google Apps Script) that
# receives {email, at, source} whenever MailerLite isn't configured or its
# API call fails, so leads aren't lost during setup.
LEAD_CAPTURE_WEBHOOK_URL=

# Gumroad product URL for the $7.99 Flavor Pairing Matrix PDF. Leave unset
# and the /free page won't advertise a purchase link that doesn't exist yet.
NEXT_PUBLIC_GUMROAD_FLAVOR_MATRIX_URL=
