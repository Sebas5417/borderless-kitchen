NEXT_PUBLIC_SITE_URL=https://borderlesskitchenseries.com

# Amazon URL for Tokyo Meets Tuscany. Leave empty to use the in-code fallback.
# NEVER set this to "#" — any non-empty value overrides the fallback and breaks CTAs.
NEXT_PUBLIC_AMAZON_URL_TMT=

# Gumroad product URL for the print-quality Flavor Pairing Matrix PDF.
# Leave empty until the product exists — the /free page hides the purchase
# link entirely when unset. NEVER set to "#".
NEXT_PUBLIC_GUMROAD_MATRIX_URL=

# MailerLite — set these in Vercel dashboard to activate email capture
# Get API key: app.mailerlite.com → Integrations → API → Create new token
# Get Group IDs: app.mailerlite.com → Subscribers → Groups → click group → copy ID from URL
MAILERLITE_API_KEY=
# General newsletter group (NewsletterForm site-wide)
MAILERLITE_GROUP_ID=
# "TMT Subscribers" group — Sauce Pack opt-in on /tokyo-meets-tuscany
MAILERLITE_TMT_GROUP_ID=
# "SMMC Waitlist" group — Seoul Meets Mexico City waitlist
MAILERLITE_SMMC_GROUP_ID=

NEWSLETTER_PROVIDER=mailerlite
